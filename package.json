{
  "name": "tortuga-duck",
  "version": "1.0.0",
  "description": "Tortuga Duck — Discord-бот для своих: музыка, приватные голосовые, приветствия, роли, новости",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit"
