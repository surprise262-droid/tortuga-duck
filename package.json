  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.56",
    "discord.js": "^14.16.3",
    "lavalink-client": "^2.3.0",
    "rss-parser": "^3.13.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
