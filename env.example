# ====== Обязательные настройки ======
# Токен бота: Discord Developer Portal → твоё приложение → Bot → Reset Token
DISCORD_TOKEN=
# Application ID: Developer Portal → General Information → Application ID
CLIENT_ID=
# ID твоего сервера: в Discord включи «Режим разработчика», ПКМ по серверу → «Копировать ID сервера»
GUILD_ID=

# Пароль между ботом и аудиосервером Lavalink. Придумай любой длинный набор символов.
LAVALINK_PASSWORD=change-me-to-something-long

# ====== Необязательные настройки (можно не трогать) ======
# Громкость по умолчанию (0–150)
DEFAULT_VOLUME=50
# Через сколько минут удалять пустой приватный канал
PRIVATE_VC_IDLE_MINUTES=15
# Как часто проверять новости (в минутах)
NEWS_INTERVAL_MINUTES=10
# Сколько новостей максимум публиковать в одну категорию за одну проверку
NEWS_MAX_PER_RUN=3
